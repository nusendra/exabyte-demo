# Copy to .env and fill in. .env is git-ignored.

# LLM provider: deepseek (default) or anthropic.
AGENT_PROVIDER=deepseek

# DeepSeek API key (if AGENT_PROVIDER=deepseek). https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Anthropic API key (if AGENT_PROVIDER=anthropic). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ClickUp personal token (starts with pk_). Settings > Apps > API Token.
CLICKUP_TOKEN=

# ClickUp List the agent watches (watch mode). List view URL: .../v/li/<LIST_ID>
CLICKUP_LIST_ID=

# Status name the agent moves the task to after opening the PR.
CLICKUP_TASK_STATUS_REVIEW=in review

# --- watch mode (npm run watch) ---
# Pick up tasks in this status, claim by moving to the in-progress status.
CLICKUP_TRIGGER_STATUS=to do
CLICKUP_INPROGRESS_STATUS=in progress
POLL_INTERVAL_MS=15000

# Model for the chosen provider. Leave unset to use the provider default
# (deepseek-v4-flash, or claude-sonnet-5 for anthropic).
# deepseek: deepseek-chat | deepseek-reasoner | deepseek-v4-flash
# anthropic: claude-opus-5 | claude-sonnet-5 | claude-opus-4-8 | claude-haiku-4-5-20251001
# AGENT_MODEL=claude-opus-5

# Monorepo root the agent edits (relative to agent/). Default: repo root.
REPO_DIR=..

# Max implement/verify retries before giving up.
MAX_ATTEMPTS=3

# Base branch PRs target.
BASE_BRANCH=main

# --- demo / testing flags ---
# DRY_RUN=1   -> skip git push, gh PR creation, and ClickUp writes (log instead)
# FAKE_LLM=1  -> skip Anthropic calls, use canned changes (wiring test, no API key needed)
