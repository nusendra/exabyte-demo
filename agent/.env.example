# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key for the agent's plan/implement/test-writing.
ANTHROPIC_API_KEY=

# ClickUp personal token (starts with pk_). Settings > Apps > API Token.
CLICKUP_TOKEN=

# Status name the agent moves the task to after opening the PR.
CLICKUP_TASK_STATUS_REVIEW=in review

# Claude model for the agent. Opus for best quality; swap to claude-sonnet-5 to save cost.
AGENT_MODEL=claude-opus-4-8

# Monorepo root the agent edits (relative to agent/). Default: repo root.
REPO_DIR=..

# Max implement/verify retries before giving up.
MAX_ATTEMPTS=3

# Base branch PRs target.
BASE_BRANCH=main

# --- demo / testing flags ---
# DRY_RUN=1   -> skip git push, gh PR creation, and ClickUp writes (log instead)
# FAKE_LLM=1  -> skip Anthropic calls, use canned changes (wiring test, no API key needed)
